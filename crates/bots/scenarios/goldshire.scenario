# A crowd walking Goldshire, and a few bots scripted to run at 14 yards a second. The movement
# check holds every runner to 7, so it corrects them and never the walkers.
place = goldshire
seconds = 60
bots.walkers.count = 100
bots.sprinters.count = 10
bots.sprinters.speed = 14
expect walkers.corrections == 0
expect walkers.refused.all == 0
expect sprinters.corrections > 0
