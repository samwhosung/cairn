place = flat
seconds = 90
rules.run = 7
rules.tolerance = 0.1
rules.slack = 0.5
rules.clock_slack_ms = 1000
rules.clock_budget_ms = 10000
bots.walkers.count = 20

bots.clock-fast.count = 1
bots.clock-fast.script = line
bots.clock-fast.lie.from_s = 5
bots.clock-fast.lie.clock_rate = 1.25
bots.clock-fast.lie.factor = 1.25

bots.clock-slow.count = 1
bots.clock-slow.script = line
bots.clock-slow.lie.from_s = 5
bots.clock-slow.lie.clock_rate = 0.5

bots.clock-back.count = 1
bots.clock-back.script = line
bots.clock-back.lie.from_s = 10
bots.clock-back.lie.clock_back_ms = 5000

bots.clock-stall.count = 1
bots.clock-stall.script = line
bots.clock-stall.claims = every-frame
bots.clock-stall.lie.from_s = 10
bots.clock-stall.lie.to_s = 20
bots.clock-stall.lie.clock_stall = yes

bots.banked.count = 1
bots.banked.script = stand
bots.banked.lie.from_s = 30
bots.banked.lie.shift = 200 0 0
bots.banked.lie.set = forward

expect walkers.corrections == 0

# Taken while its clock leads by no more than `rules.clock_slack_ms` and `rules.clock_budget_ms`,
# eleven seconds, which a clock a quarter fast spends in 44 seconds; then refused.
expect clock-fast.through_after_s < 1
expect clock-fast.caught_after_s > 40
expect clock-fast.caught_after_s < 50
expect clock-fast.past_honest_yd > 70
expect clock-fast.control_corrections == 0

# Refused at its first heartbeat: the ground covered is too much for the time it claims.
expect clock-slow.caught_after_s <= 1.1
expect clock-slow.past_honest_yd < 1
expect clock-slow.control_corrections == 0

expect clock-back.caught_after_s <= 0.1
expect clock-back.past_honest_yd < 1
expect clock-back.control_corrections == 0
# Its true places are taken again in one step of hundreds of yards, which whoever held it and can
# no longer read its place lets go that tick.
expect clock-back.seen_misread == 0
expect clock-back.kept_past_reach == 0

# A known hole: claims every frame with a clock that stands still each cover less than the slack,
# so a stalled clock goes unseen.
expect clock-stall.lies_refused == 0
expect clock-stall.past_honest_yd < 1
expect clock-stall.control_corrections == 0

# A known hole: a claim may cover the ground of the faster of its flags and the last taken
# claim's, for all the time since that claim, so standing silent banks a teleport.
expect banked.lies_refused == 0
expect banked.past_honest_yd > 199
expect banked.control_corrections == 0
