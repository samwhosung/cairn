place = flat
seconds = 30
limits.run = 7
limits.tolerance = 0.1
limits.slack = 0.5
bots.walkers.count = 20

bots.speed-3x.count = 1
bots.speed-3x.script = line
bots.speed-3x.lie.from_s = 5
bots.speed-3x.lie.to_s = 15
bots.speed-3x.lie.factor = 3

bots.speed-5x-frames.count = 1
bots.speed-5x-frames.script = line
bots.speed-5x-frames.frame_hz = 60
bots.speed-5x-frames.claims = every-frame
bots.speed-5x-frames.lie.from_s = 5
bots.speed-5x-frames.lie.to_s = 15
bots.speed-5x-frames.lie.factor = 5

bots.speed-flood.count = 1
bots.speed-flood.script = line
bots.speed-flood.frame_hz = 1000
bots.speed-flood.claims = every-frame
bots.speed-flood.lie.from_s = 5
bots.speed-flood.lie.to_s = 15
bots.speed-flood.lie.factor = 20

expect walkers.corrections == 0

# Refused at its first claim of a half second's run, three times too long.
expect speed-3x.caught_after_s <= 0.6
expect speed-3x.past_honest_yd < 1
expect speed-3x.control_corrections == 0

# A known hole: the slack comes with every claim, so claims every frame carry five times a run.
expect speed-5x-frames.lies_refused == 0
expect speed-5x-frames.past_honest_yd > 250
expect speed-5x-frames.control_corrections == 0

expect speed-flood.lies_refused == 0
expect speed-flood.past_honest_yd > 1000
expect speed-flood.control_corrections == 0
